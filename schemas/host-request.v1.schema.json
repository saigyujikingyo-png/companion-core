{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:host-request:v1",
  "description": "Selected-text ingress profile; maximum encoded body is 65536 UTF-8 bytes. Host authentication, fixed session equality and scope epoch are checked outside this document.",
  "type": "object", "additionalProperties": false,
  "required": ["version", "operation", "event"],
  "properties": {
    "version": { "const": 1 }, "operation": { "const": "extract_memory" },
    "event": { "oneOf": [{ "$ref": "#/$defs/dsh" }, { "$ref": "#/$defs/codex" }] }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]*$" },
    "session": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]*$" },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" },
    "dsh": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "event"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/session" },
        "event": {
          "type": "object", "additionalProperties": false, "required": ["type", "seq", "time", "data", "surfaceOp"],
          "properties": {
            "type": { "const": "user/message" }, "seq": { "$ref": "#/$defs/time" }, "time": { "$ref": "#/$defs/time" }, "surfaceOp": { "const": "append" },
            "data": {
              "type": "object", "additionalProperties": false, "required": ["id", "role", "content", "source"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" }, "role": { "const": "user" },
                "content": {
                  "type": "array", "minItems": 1, "maxItems": 32,
                  "items": { "type": "object", "additionalProperties": false, "required": ["type", "text"],
                    "properties": { "type": { "const": "text" }, "text": { "$ref": "#/$defs/text" } } }
                },
                "source": {
                  "type": "object", "additionalProperties": false, "required": ["kind", "rpcId"],
                  "properties": {
                    "kind": { "const": "user" }, "rpcId": { "$ref": "#/$defs/identifier" },
                    "clientTimeZone": { "$ref": "#/$defs/session" }, "principal": { "description": "Ignored native metadata; never authority." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "codex": {
      "type": "object", "additionalProperties": false, "required": ["method", "params"],
      "properties": {
        "method": { "const": "item/completed" },
        "params": {
          "type": "object", "additionalProperties": false, "required": ["threadId", "turnId", "completedAtMs", "item"],
          "properties": {
            "threadId": { "$ref": "#/$defs/session" }, "turnId": { "$ref": "#/$defs/identifier" }, "completedAtMs": { "$ref": "#/$defs/time" },
            "item": {
              "type": "object", "additionalProperties": false, "required": ["type", "id", "content"],
              "properties": {
                "type": { "const": "userMessage" }, "id": { "$ref": "#/$defs/identifier" }, "clientId": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
                "content": {
                  "type": "array", "minItems": 1, "maxItems": 32,
                  "items": { "type": "object", "additionalProperties": false, "required": ["type", "text"],
                    "properties": { "type": { "const": "text" }, "text": { "$ref": "#/$defs/text" }, "text_elements": { "type": "array", "maxItems": 0 } } }
                }
              }
            }
          }
        }
      }
    }
  }
}
