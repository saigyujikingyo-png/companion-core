{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:proposal-response:v1",
  "description": "Additional semantic check: nonnull validTo must exceed nonnull validFrom. Statement length is measured in JavaScript UTF-16 code units by the runtime validator.",
  "type": "object", "additionalProperties": false, "required": ["version", "proposal"],
  "properties": {
    "version": { "const": 1 },
    "proposal": {
      "type": "object", "additionalProperties": false, "required": ["kind", "statement", "basis", "validFrom", "validTo"],
      "properties": {
        "kind": { "enum": ["claim", "status", "belief", "commitment", "episode"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" },
        "basis": { "enum": ["self_report", "observation", "inference"] },
        "validFrom": { "$ref": "#/$defs/time" }, "validTo": { "$ref": "#/$defs/time" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "belief" } } }, "then": { "properties": { "basis": { "const": "inference" }, "validTo": { "type": "integer" } } } },
        { "if": { "properties": { "basis": { "const": "inference" } } }, "then": { "properties": { "kind": { "const": "belief" } } } },
        { "if": { "properties": { "kind": { "const": "status" } } }, "then": { "properties": { "validTo": { "type": "integer" } } } }
      ]
    }
  },
  "$defs": { "time": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 } }
}
